@{
    ViewData["Title"] = "ارسال پیامک";
}


<div class="qi-card">
    <h2>📧 ارسال پیامک</h2>
    <p style="color:var(--qi-text-muted);">پیامک‌های خودکار و دستی به والدین.</p>
</div>


<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(280px,1fr)); gap:16px;">
    <div class="qi-card" style="border-color:#fecaca;">
        <h3 style="color:#b91c1c; margin-top:0;">🚫 پیامک غیبت</h3>
        <p style="font-size:13px; color:#6b7280;">
            ارسال پیامک به والدین شاگردان غایب در یک تاریخ خاص.
        </p>
        <a href="/Admin/Sms/SendAbsent" class="qi-btn red">ارسال</a>
    </div>

    <div class="qi-card" style="border-color:#fde68a;">
        <h3 style="color:#92400e; margin-top:0;">💰 پیامک یادآوری بدهی</h3>
        <p style="font-size:13px; color:#6b7280;">
            ارسال پیامک به والدین شاگردان بدهکار.
        </p>
        <a href="/Admin/Sms/SendDebt" class="qi-btn" style="background:#b45309;">ارسال</a>
    </div>

   

    <div class="qi-card">
        <h3 style="color:#0f766e; margin-top:0;">📢 اطلاعیه عمومی</h3>
        <p style="font-size:13px; color:#6b7280;">
            ساخت اطلاعیه با امکان ارسال SMS.
        </p>
        <a href="/Admin/Announcements/Create" class="qi-btn">ایجاد اطلاعیه</a>
    </div>
</div>

<div style="margin-bottom:16px;">
    <a href="/Admin/Sms/History" class="qi-btn blue">📜 تاریخچه پیامک‌ها</a>
</div>

<div style="background:#fef3c7; border:1px solid #fde68a; padding:14px 18px; border-radius:10px;
            margin-top:16px; font-size:13px; color:#92400e;">
    💡 <b>توجه:</b> ارسال پیامک نیاز به تنظیم API Key کاوه‌نگار در appsettings.json دارد.
    تا زمان پیکربندی، پیام‌ها فقط در لاگ ثبت می‌شوند (Dry-Run).
</div>
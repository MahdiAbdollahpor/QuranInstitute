@model QuranInstitute.Web.ViewModels.Students.StudentListViewModel
@using QuranInstitute.Shared.Helpers
@{
    ViewData["Title"] = "شاگردان";
}

<div class="qi-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h2>لیست شاگردان (@Model.Students.TotalCount نفر)</h2>
        <a href="/Admin/Students/Create" class="qi-btn">+ ثبت شاگرد جدید</a>
    </div>

    <form method="get" style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;">
        <input type="text" name="search" value="@Model.Search"
               placeholder="جستجو (نام، ولی، موبایل)…"
               style="flex:1; min-width:200px; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;" />

        <select name="classId"
                style="padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit; min-width:180px;">
            <option value="">همه کلاس‌ها</option>
            @foreach (var c in Model.Classes)
            {
                <option value="@c.Value" selected="@(c.Selected)">@c.Text</option>
            }
        </select>

        <button type="submit" class="qi-btn">فیلتر</button>
        <a href="/Admin/Students" class="qi-btn gray">پاک‌کردن</a>
    </form>

    @if (!Model.Students.Items.Any())
    {
        <p style="color:var(--qi-text-muted); text-align:center; padding:30px;">
            هیچ شاگردی یافت نشد.
        </p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="background:#eef3f2; font-size:13px;">
                        <th style="padding:10px; text-align:right;">#</th>
                        <th style="padding:10px; text-align:right;">نام</th>
                        <th style="padding:10px; text-align:right;">ولی</th>
                        <th style="padding:10px; text-align:right;">موبایل</th>
                        <th style="padding:10px; text-align:right;">کلاس</th>
                        <th style="padding:10px; text-align:right;">شهریه ماهانه</th>
                        <th style="padding:10px; text-align:right;">شروع</th>
                        <th style="padding:10px; text-align:right;"></th>
                    </tr>
                </thead>
                <tbody>
                    @{
                        var idx = (Model.Students.Page - 1) * Model.Students.PageSize;
                    }
                    @foreach (var s in Model.Students.Items)
                    {
                        idx++;
                        <tr style="border-bottom:1px solid #e5eae9;">
                            <td style="padding:10px;">@idx.ToPersianDigits()</td>
                            <td style="padding:10px;"><strong>@s.Name</strong></td>
                            <td style="padding:10px;">@s.ParentName</td>
                            <td style="padding:10px; direction:ltr; text-align:right;">
                                @s.ParentMobile.ToPersianDigits()
                            </td>
                            <td style="padding:10px;">@s.ClassName</td>
                            <td style="padding:10px;">
                                @s.MonthlyFee.ToString("N0").ToPersianDigits() تومان
                            </td>
                            <td style="padding:10px;">
                                @s.StartDate.GetShamsiDateFromGregorian(time: false).ToPersianDigits()
                            </td>
                            <td style="padding:10px; white-space:nowrap;">
                                <a href="/Admin/Students/Edit/@s.Id" class="qi-btn sm">ویرایش</a>
                                <form method="post" action="/Admin/Students/Deactivate/@s.Id"
                                      style="display:inline;"
                                      onsubmit="return confirm('آیا از غیرفعال‌سازی این شاگرد مطمئن هستید؟');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="qi-btn sm red">غیرفعال</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Students.TotalPages > 1)
        {
            <div style="display:flex; gap:6px; justify-content:center; margin-top:20px;">
                @for (int i = 1; i <= Model.Students.TotalPages; i++)
                {
                    <a href="?page=@i&search=@Model.Search&classId=@Model.ClassId"
                       class="qi-btn sm @(i == Model.Students.Page ? "" : "gray")">
                        @i.ToPersianDigits()
                    </a>
                }
            </div>
        }
    }
</div>
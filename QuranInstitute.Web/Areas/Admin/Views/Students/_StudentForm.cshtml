@model QuranInstitute.Web.ViewModels.Students.BaseStudentFormViewModel
@{
    var submitLabel = (string?)ViewBag.SubmitLabel ?? "ذخیره";
    var formAction = (string?)ViewBag.FormAction ?? "";
}

<form method="post" action="@formAction" novalidate>
    @Html.AntiForgeryToken()

    @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
    {
        <div style="background:#fef2f2; border:1px solid #fecaca; color:#b91c1c;
                        padding:10px 14px; border-radius:8px; margin-bottom:16px; font-size:13px;">
            @ViewData.ModelState[""]!.Errors.First().ErrorMessage
        </div>
    }

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(220px,1fr)); gap:16px;">

        <div>
            <label asp-for="Name" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                نام و نام خانوادگی <span style="color:#b91c1c;">*</span>
            </label>
            <input asp-for="Name" type="text"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;" />
            <span asp-validation-for="Name" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div>
            <label asp-for="ParentName" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                نام ولی <span style="color:#b91c1c;">*</span>
            </label>
            <input asp-for="ParentName" type="text"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;" />
            <span asp-validation-for="ParentName" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div>
            <label asp-for="ParentMobile" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                شماره موبایل ولی <span style="color:#b91c1c;">*</span>
            </label>
            <input asp-for="ParentMobile" type="text" inputmode="numeric"
                   placeholder="09123456789" dir="ltr"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;" />
            <span asp-validation-for="ParentMobile" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div>
            <label asp-for="ClassId" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                کلاس
            </label>
            <select asp-for="ClassId" asp-items="Model.Classes"
                    style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;">
                <option value="">— بدون کلاس —</option>
            </select>
        </div>

        <div>
            <label asp-for="MonthlyFee" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                شهریه ماهانه (تومان)
            </label>
            <input asp-for="MonthlyFee" type="number" min="0" step="1000"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;" />
            <span asp-validation-for="MonthlyFee" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div>
            <label asp-for="StartDate" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                تاریخ شروع شهریه
            </label>
            <input asp-for="StartDate" type="date"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;" />
            <span asp-validation-for="StartDate" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div style="grid-column:1/-1;">
            <label asp-for="Note" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563;">
                توضیحات
            </label>
            <textarea asp-for="Note" rows="3"
                      style="width:100%; padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit; resize:vertical;"></textarea>
        </div>
    </div>

    <div style="margin-top:24px; display:flex; gap:10px;">
        <button type="submit" class="qi-btn">@submitLabel</button>
        <a href="/Admin/Students" class="qi-btn gray">انصراف</a>
    </div>
</form>
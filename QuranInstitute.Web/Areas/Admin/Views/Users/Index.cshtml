@model QuranInstitute.Web.ViewModels.Admin.UserListViewModel
@using QuranInstitute.Shared.Helpers
@{
    ViewData["Title"] = "کاربران";

    var roleNames = new Dictionary<string, string>
    {
        { "Admin", "مدیر" },
        { "Teacher", "استاد" },
        { "Parent", "والد" },
        { "Student", "شاگرد" }
    };

    var roleColors = new Dictionary<string, string>
    {
        { "Admin", "#b91c1c" },
        { "Teacher", "#1d4ed8" },
        { "Parent", "#0f766e" },
        { "Student", "#16a34a" }
    };
}

<div class="qi-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h2>لیست کاربران (@Model.Users.TotalCount نفر)</h2>
    </div>

    <form method="get" style="display:flex; gap:10px; flex-wrap:wrap; margin-bottom:16px;">
        <input type="text" name="search" value="@Model.Search"
               placeholder="جستجو (نام، موبایل، کد ملی)…"
               style="flex:1; min-width:200px; padding:9px 12px; border:1px solid var(--qi-border);
                      border-radius:8px; font-family:inherit;" />

        <select name="role"
                style="padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;">
            @foreach (var r in Model.RoleOptions)
            {
                <option value="@r.Value" selected="@r.Selected">@r.Text</option>
            }
        </select>

        <select name="activeOnly"
                style="padding:9px 12px; border:1px solid var(--qi-border); border-radius:8px; font-family:inherit;">
            <option value="">همه</option>
            <option value="true" selected="@(Model.ActiveOnly == true)">فقط فعال</option>
            <option value="false" selected="@(Model.ActiveOnly == false)">فقط غیرفعال</option>
        </select>

        <button type="submit" class="qi-btn">فیلتر</button>
        <a href="/Admin/Users" class="qi-btn gray">پاک‌کردن</a>
    </form>

    @if (!Model.Users.Items.Any())
    {
        <p style="color:var(--qi-text-muted); text-align:center; padding:30px;">
            کاربری یافت نشد.
        </p>
    }
    else
    {
        <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse;">
                <thead>
                    <tr style="background:#eef3f2; font-size:13px;">
                        <th style="padding:10px; text-align:right;">نام</th>
                        <th style="padding:10px; text-align:right;">موبایل</th>
                        <th style="padding:10px; text-align:right;">نقش</th>
                        <th style="padding:10px; text-align:right;">شاگردان</th>
                        <th style="padding:10px; text-align:right;">وضعیت</th>
                        <th style="padding:10px; text-align:right;">آخرین ورود</th>
                        <th style="padding:10px; text-align:right;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model.Users.Items)
                    {
                        var primaryRole = u.Roles.FirstOrDefault() ?? "—";
                        var roleLabel = roleNames.ContainsKey(primaryRole) ? roleNames[primaryRole] : primaryRole;
                        var roleColor = roleColors.ContainsKey(primaryRole) ? roleColors[primaryRole] : "#6b7280";

                        <tr style="border-bottom:1px solid #e5eae9;">
                            <td style="padding:10px;"><strong>@u.FullName</strong></td>
                            <td style="padding:10px; direction:ltr; text-align:right;">
                                @u.Mobile.ToPersianDigits()
                            </td>
                            <td style="padding:10px;">
                                <span style="background:@roleColor; color:#fff; padding:3px 10px;
                                                     border-radius:20px; font-size:12px;">
                                    @roleLabel
                                </span>
                            </td>
                            <td style="padding:10px;">
                                @if (u.LinkedStudentsCount > 0)
                                {
                                    <span style="background:#f0fdf4; color:#16a34a; padding:2px 8px;
                                                             border-radius:10px; font-size:12px;">
                                        @u.LinkedStudentsCount.ToPersianDigits()
                                    </span>
                                }
                                else
                                {
                                    <span style="color:var(--qi-text-muted);">—</span>
                                }
                            </td>
                            <td style="padding:10px;">
                                @if (u.IsActive)
                                {
                                    <span style="color:#16a34a; font-size:13px;">✅ فعال</span>
                                }
                                else
                                {
                                    <span style="color:#b91c1c; font-size:13px;">⛔ غیرفعال</span>
                                }
                            </td>
                            <td style="padding:10px; font-size:13px;">
                                @if (u.LastLoginAt.HasValue)
                                {
                                    @u.LastLoginAt.Value.GetShamsiDateFromGregorian(time: true).ToPersianDigits()
                                }
                                else
                                {
                                    <span style="color:var(--qi-text-muted);">—</span>
                                }
                            </td>
                            <td style="padding:10px; white-space:nowrap;">
                                <a href="/Admin/Users/Details/@u.Id" class="qi-btn sm">جزئیات</a>
                                <a href="/Admin/Users/ResetPassword/@u.Id" class="qi-btn sm blue">🔑 رمز</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.Users.TotalPages > 1)
        {
            <div style="display:flex; gap:6px; justify-content:center; margin-top:20px;">
                @for (int i = 1; i <= Model.Users.TotalPages; i++)
                {
                    <a href="?page=@i&search=@Model.Search&role=@Model.RoleFilter&activeOnly=@Model.ActiveOnly"
                       class="qi-btn sm @(i == Model.Users.Page ? "" : "gray")">
                        @i.ToPersianDigits()
                    </a>
                }
            </div>
        }
    }
</div>
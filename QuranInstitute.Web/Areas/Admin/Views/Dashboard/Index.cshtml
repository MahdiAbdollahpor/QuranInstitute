@using QuranInstitute.Shared.Helpers
@{
    ViewData["Title"] = "داشبورد";
}

<div class="qi-card">
    <h2>خوش آمدید 👋</h2>
    <p>این پنل مدیریت موسسه قرآنی است. از منوی کنار، بخش مورد نظر را انتخاب کنید.</p>
</div>

<div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(200px,1fr)); gap:16px;">
    <div class="qi-card">
        <div style="color:#6b7280; font-size:12px;">شاگردان</div>
        <div style="font-size:24px; color:#0f766e; font-weight:700; margin-top:6px;">۰</div>
    </div>
    <div class="qi-card">
        <div style="color:#6b7280; font-size:12px;">کلاس‌ها</div>
        <div style="font-size:24px; color:#0f766e; font-weight:700; margin-top:6px;">۰</div>
    </div>
    <div class="qi-card">
        <div style="color:#6b7280; font-size:12px;">دریافتی این ماه</div>
        <div style="font-size:24px; color:#0f766e; font-weight:700; margin-top:6px;">۰ تومان</div>
    </div>
    <div class="qi-card">
        <div style="color:#6b7280; font-size:12px;">بدهی‌ها</div>
        <div style="font-size:24px; color:#b91c1c; font-weight:700; margin-top:6px;">۰ تومان</div>
    </div>
</div>

@if ((int)(ViewBag.PendingCount ?? 0) > 0)
{
    <div class="qi-card" style="background:#fef3c7; border-color:#f59e0b;">
        <h2 style="color:#92400e;">⏳ ثبت‌نام‌های در انتظار تأیید</h2>
        <p>
            <b>@(((int)ViewBag.PendingCount).ToPersianDigits())</b> ثبت‌نام در انتظار بررسی است.
        </p>
        <a href="/Admin/Enrollments?status=1" class="qi-btn">مشاهده و بررسی</a>
    </div>
}
@model QuranInstitute.Web.ViewModels.UserPanel.ChangePasswordViewModel
@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<div class="qi-card" style="max-width:500px;">
    <h2>🔒 تغییر رمز عبور</h2>

    <form method="post" action="/User/Profile/ChangePassword" novalidate>
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
        {
            <div style="background:#fef2f2; border:1px solid #fecaca; color:#b91c1c;
                            padding:10px 14px; border-radius:8px; margin-bottom:16px; font-size:13px;">
                @ViewData.ModelState[""]!.Errors.First().ErrorMessage
            </div>
        }

        <div style="margin-bottom:14px;">
            <label asp-for="CurrentPassword" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563; font-weight:500;">
                رمز فعلی <span style="color:#b91c1c;">*</span>
            </label>
            <input asp-for="CurrentPassword" type="password"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border);
                          border-radius:8px; font-family:inherit; direction:ltr;" />
            <span asp-validation-for="CurrentPassword" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div style="margin-bottom:14px;">
            <label asp-for="NewPassword" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563; font-weight:500;">
                رمز جدید <span style="color:#b91c1c;">*</span>
            </label>
            <input asp-for="NewPassword" type="password"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border);
                          border-radius:8px; font-family:inherit; direction:ltr;" />
            <span asp-validation-for="NewPassword" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div style="margin-bottom:20px;">
            <label asp-for="ConfirmPassword" style="display:block; font-size:13px; margin-bottom:6px; color:#4b5563; font-weight:500;">
                تکرار رمز جدید <span style="color:#b91c1c;">*</span>
            </label>
            <input asp-for="ConfirmPassword" type="password"
                   style="width:100%; padding:9px 12px; border:1px solid var(--qi-border);
                          border-radius:8px; font-family:inherit; direction:ltr;" />
            <span asp-validation-for="ConfirmPassword" style="color:#b91c1c; font-size:12px;"></span>
        </div>

        <div style="display:flex; gap:10px;">
            <button type="submit" class="qi-btn">تغییر رمز</button>
            <a href="/User/Profile" class="qi-btn gray">انصراف</a>
        </div>
    </form>
</div>
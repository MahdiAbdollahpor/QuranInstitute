@model QuranInstitute.Web.ViewModels.Sessions.SessionsListViewModel
@using QuranInstitute.Shared.Helpers
@{
    ViewData["Title"] = $"جلسات {Model.Data.ClassName}";
}

<div class="qi-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px; flex-wrap:wrap; gap:10px;">
        <h2>جلسات کلاس @Model.Data.ClassName</h2>
        <a href="/User/Classes" class="qi-btn gray">بازگشت</a>
    </div>

    @if (!Model.Data.Sessions.Any())
    {
        <p style="color:var(--qi-text-muted); text-align:center; padding:40px;">
            هنوز جلسه‌ای ثبت نشده است.
        </p>
    }
    else
    {
        <div style="display:flex; flex-direction:column; gap:12px;">
            @foreach (var s in Model.Data.Sessions)
            {
                <div style="border:1px solid var(--qi-border); border-radius:10px; padding:16px;">
                    <div style="display:flex; justify-content:space-between; align-items:start; gap:12px; flex-wrap:wrap;">
                        <div style="flex:1; min-width:200px;">
                            <div style="font-weight:700; font-size:15px;">
                                جلسه @s.SessionNumber.ToPersianDigits() — @s.Title
                            </div>
                            <div style="font-size:12px; color:var(--qi-text-muted); margin-top:4px;">
                                @s.Date.GetShamsiDateFromGregorian(time: false).ToPersianDigits()
                                @if (s.IsOnline)
                                {
                                    <span style="background:#1d4ed8; color:#fff; padding:2px 8px;
                                                             border-radius:10px; margin-right:8px; font-size:11px;">آنلاین</span>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(s.Description))
                            {
                                <div style="font-size:13px; color:#4b5563; margin-top:8px;">
                                    @s.Description
                                </div>
                            }
                        </div>

                        <div style="display:flex; flex-direction:column; gap:6px;">
                            @if (!string.IsNullOrEmpty(s.OnlineLink))
                            {
                                <a href="@s.OnlineLink" target="_blank" class="qi-btn sm blue">
                                    🔗 ورود به کلاس
                                </a>
                            }
                            @if (!string.IsNullOrEmpty(s.RecordingUrl))
                            {
                                <a href="@s.RecordingUrl" target="_blank" class="qi-btn sm green">
                                    🎬 فیلم جلسه
                                </a>
                            }
                            <a href="/User/Resources?classId=@s.ClassId"
                               class="qi-btn sm gray">
                                📁 فایل‌ها (@s.ResourceCount.ToPersianDigits())
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
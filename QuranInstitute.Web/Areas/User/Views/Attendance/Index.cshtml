@model QuranInstitute.Web.ViewModels.UserPanel.MyAttendanceViewModel
@using QuranInstitute.Shared.Helpers
@using QuranInstitute.Domain.Enums
@{
    ViewData["Title"] = "حضور و غیاب";

    var statusMap = new Dictionary<AttendanceStatus, (string text, string bg)>
    {
        { AttendanceStatus.Present, ("حاضر", "#16a34a") },
        { AttendanceStatus.Absent, ("غایب", "#b91c1c") },
        { AttendanceStatus.Late, ("تأخیر", "#b45309") },
        { AttendanceStatus.Excused, ("موجه", "#1d4ed8") }
    };
}

<div class="qi-card">
    <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:16px;">
        <h2>حضور و غیاب @Model.Data.StudentName</h2>
    </div>

    <div style="display:grid; grid-template-columns:repeat(auto-fit, minmax(140px,1fr)); gap:12px; margin-bottom:20px;">
        <div style="background:#f0fdf4; padding:12px; border-radius:10px;">
            <div style="font-size:12px; color:#166534;">حاضر</div>
            <div style="font-size:20px; font-weight:700; color:#16a34a;">@Model.Data.PresentCount.ToPersianDigits()</div>
        </div>
        <div style="background:#fef2f2; padding:12px; border-radius:10px;">
            <div style="font-size:12px; color:#991b1b;">غایب</div>
            <div style="font-size:20px; font-weight:700; color:#b91c1c;">@Model.Data.AbsentCount.ToPersianDigits()</div>
        </div>
        <div style="background:#fef3c7; padding:12px; border-radius:10px;">
            <div style="font-size:12px; color:#92400e;">تأخیر</div>
            <div style="font-size:20px; font-weight:700; color:#b45309;">@Model.Data.LateCount.ToPersianDigits()</div>
        </div>
        <div style="background:#eff6ff; padding:12px; border-radius:10px;">
            <div style="font-size:12px; color:#1e40af;">موجه</div>
            <div style="font-size:20px; font-weight:700; color:#1d4ed8;">@Model.Data.ExcusedCount.ToPersianDigits()</div>
        </div>
    </div>

    @if (!Model.Data.Rows.Any())
    {
        <p style="color:var(--qi-text-muted); text-align:center; padding:30px;">
            هیچ رکورد حضوری برای شما ثبت نشده است.
        </p>
    }
    else
    {
        <table style="width:100%; border-collapse:collapse;">
            <thead>
                <tr style="background:#eef3f2; font-size:13px;">
                    <th style="padding:10px; text-align:right;">تاریخ</th>
                    <th style="padding:10px; text-align:right;">کلاس</th>
                    <th style="padding:10px; text-align:right;">وضعیت</th>
                    <th style="padding:10px; text-align:right;">توضیحات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var r in Model.Data.Rows)
                {
                    var map = statusMap[r.Status];
                    <tr style="border-bottom:1px solid #e5eae9;">
                        <td style="padding:10px; font-size:13px;">
                            @r.Date.GetShamsiDateFromGregorian(time: false).ToPersianDigits()
                        </td>
                        <td style="padding:10px;">@r.ClassName</td>
                        <td style="padding:10px;">
                            <span style="background:@map.bg; color:#fff; padding:3px 10px; border-radius:20px; font-size:12px;">
                                @map.text
                            </span>
                        </td>
                        <td style="padding:10px; color:var(--qi-text-muted); font-size:12px;">@r.Note</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>